# Supabase: Project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js: generate with `openssl rand -hex 32`
AUTH_SECRET=

# Email magic links via Resend (leave empty to turn off)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Essência Family <family@essencia.life>"

# Google login (leave empty to turn off). Redirect URI: <site>/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
